# ============================================================
# DesignRAG — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env

# OpenAI API key (required) — used for embeddings and LLM calls
OPENAI_API_KEY=sk-your-key-here

# ChromaDB storage path (optional, defaults to ./chroma_db)
# CHROMA_DB_PATH=./chroma_db

# OpenAI embedding model (optional, defaults to text-embedding-3-small)
# EMBEDDING_MODEL=text-embedding-3-small

# OpenAI LLM model (optional, defaults to gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# Chunking parameters (optional)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# Max tokens of retrieved context to include in the LLM prompt (optional)
# CONTEXT_TOKEN_BUDGET=4000

# Enable LLM-based reranking of search results (optional, default false)
# Adds one extra LLM call per query but improves retrieval precision.
# RERANKING_ENABLED=false
